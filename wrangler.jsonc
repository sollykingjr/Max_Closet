{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maxs-closet",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fit-ledger",
      "database_id": "fbbd1410-6dc1-4c24-95f7-c9551edd8892"
    }
  ],
  "vars": {
    // openai | gemini | anthropic  (add the matching *_API_KEY as a secret)
    "PROVIDER": "openai",
    // Only this signed-in email can use the app. Requires Cloudflare Access (see README).
    "ALLOWED_EMAIL": "maxcsolomon@gmail.com"
  }
}
